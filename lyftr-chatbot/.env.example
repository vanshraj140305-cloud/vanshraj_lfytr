# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-key-1,your-key-2
# Any LiteLLM model string. The keys must belong to this provider.
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
# Must be true on the deployed backend so X-Simulate-Failure works
ENABLE_FAILURE_SIMULATION=true
# Optional
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_TYPE=local
CACHE_DIR=/data/llm_cache
MAX_OUTPUT_TOKENS=1024
# Frontend build-time: URL of the backend as seen from the browser
VITE_API_URL=http://localhost:8000
